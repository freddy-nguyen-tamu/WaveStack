{
  "manifest_version": 3,
  "name": "Comic Bridge — Local Reader",
  "description": "Automatically reconnects to the local Python archiver and the selected comic tab; no code required.",
  "version": "1.5.17",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "debugger",
    "activeTab",
    "alarms",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:18765/*",
    "https://toonily.com/*",
    "https://data.tnlycdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://toonily.com/serie/breakaway-joys-of-travel-f99c6f14/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
