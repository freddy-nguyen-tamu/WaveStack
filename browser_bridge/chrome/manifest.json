{
  "manifest_version": 3,
  "name": "Comic Bridge — Local Reader",
  "description": "Automatically reconnects to the local Python archiver and the selected comic tab; no code required.",
  "version": "1.5.17",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "debugger",
    "activeTab",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:18765/*",
    "https://comix.to/*",
    "https://8pl.olivawrites.site/*",
    "https://8pl.lifebetweenlines.site/*",
    "https://8pl.quietreflectionsblog.site/*",
    "https://8pl.ericlog.site/*",
    "https://8pl.mycreativespace.site/*",
    "https://8pl.pureandsimpleshop.site/*",
    "https://8pl.homeandheartshop.site/*",
    "https://8pl.notesbykevin.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://comix.to/title/65gg-orange-marmalade/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
